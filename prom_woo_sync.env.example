# ============================================================
# Скопіюй цей файл у .env (в тій самій папці, що й prom_woo_sync.py)
# і заповни своїми реальними даними.
#
#   cp prom_woo_sync.env.example .env
#   chmod 600 .env
#
# Файл .env НІКОЛИ не викладай на GitHub / не показуй нікому.
# ============================================================

# Посилання на XML-фід партнера (Prom.ua Google Merchant export)
FEED_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Дані твого WooCommerce магазину
WC_URL=https://твій-реальний-домен.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твоя націнка. 0.20 означає +20% до ціни партнера
MARKUP=0.20

# Префікс SKU, щоб відрізняти ці товари від інших у магазині
SKU_PREFIX=OLB-

# Ховати товари, яких більше немає у фіді партнера (true/false)
DEACTIVATE_MISSING=true
