# ============================================================
# Скопіюй цей файл у prom_woo_sync.env (в тій самій папці, що й
# prom_woo_sync.py та seo_generator.py) і заповни своїми реальними даними.
# Обидва скрипти читають ЦЕЙ ОДИН файл — секрети зберігаються в одному місці.
#
#   cp prom_woo_sync.env.example prom_woo_sync.env
#   chmod 600 prom_woo_sync.env
#
# Файл prom_woo_sync.env НІКОЛИ не викладай на GitHub / не показуй нікому
# (він уже в .gitignore, але про всяк випадок).
# ============================================================

# Посилання на XML-фід партнера (Prom.ua Google Merchant export)
FEED_URL=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Дані твого WooCommerce магазину
WC_URL=https://твій-реальний-домен.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твоя націнка. 0.20 означає +20% до ціни партнера
MARKUP=0.20

# Префікс SKU, щоб відрізняти ці товари від інших у магазині
SKU_PREFIX=OLB-

# Ховати товари, яких більше немає у фіді партнера (true/false)
DEACTIVATE_MISSING=true

# ==== Захист від масового приховування товарів при збої фіда ====
# Якщо новий фід має менше товарів, ніж MIN_FEED_RATIO * попередній результат,
# синхронізація зупиниться і НІЧОГО не змінить у магазині.
# 0.7 = якщо товарів стало менше 70% від минулого разу - це підозріло, стоп.
MIN_FEED_RATIO=0.7

# ==== Сповіщення в Telegram про збої (опційно, можна лишити порожнім) ====
# Як отримати: створи бота через @BotFather -> отримаєш TELEGRAM_BOT_TOKEN
# Свій chat_id можна дізнатись через бота @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== SEO-генератор (seo_generator.py) — Rank Math через OpenAI ====
# Реєстрація: platform.openai.com -> API keys. Ключ починається на "sk-".
# Якщо лишити порожнім - seo_generator.py сам себе тихо вимкне і напише
# про це в лог, а НЕ зупинить основну синхронізацію prom_woo_sync.py.
OPENAI_API_KEY=

# Модель для генерації SEO. gpt-4o-mini достатньо і дешево
# (орієнтовно $0.10-0.20 на 1400 товарів разового прогону).
SEO_OPENAI_MODEL=gpt-4o-mini

# Пауза між зверненнями до OpenAI (секунди) при масовому прогоні --all,
# щоб не впертись у ліміт запитів на хвилину (RPM).
SEO_REQUEST_DELAY=1.0
